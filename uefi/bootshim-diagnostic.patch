--- a/BootShim/BootShim.S
+++ b/BootShim/BootShim.S
@@ -17,6 +17,39 @@
 #endif
 
 _Start:
+#ifdef CUPID_SHIM_BEACON
+  /*
+   * Cupid bring-up test, before the FD is copied.
+   *   screen: paint the ABL splash buffer (Display Reserved 0xB8000000) -> the panel is
+   *           still scanned out and our code is running.
+   *   reset:  write IMEM restart_reason 0x77665500 at 0x146AA65C and ask PSCI to reset.
+   *           Landing in fastboot means this code ran; landing in Android means it never did.
+   */
+  ldr   x7, =0xB8000000
+  ldr   x8, =(1080 * 2400)
+  movz  w9, #0x00ff
+  movk  w9, #0xff00, lsl #16
+_CupidFb:
+  str   w9, [x7], #4
+  subs  x8, x8, #1
+  b.ne  _CupidFb
+  dsb   sy
+  movz  x7, #0xa65c
+  movk  x7, #0x146a, lsl #16
+  movz  w3, #0x5500
+  movk  w3, #0x7766, lsl #16
+  str   w3, [x7]
+  dsb   sy
+  movz  x0, #0x0009
+  movk  x0, #0x8400, lsl #16
+  mov   x1, xzr
+  mov   x2, xzr
+  mov   x3, xzr
+  smc   #0
+_CupidHold:
+  wfe
+  b     _CupidHold
+#endif
   mov   x4, x1
   ldr   x5, =FD_BASE
   cmp   x4, x5
